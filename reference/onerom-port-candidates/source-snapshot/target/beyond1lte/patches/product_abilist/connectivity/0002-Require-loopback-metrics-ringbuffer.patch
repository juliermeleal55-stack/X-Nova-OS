Subject: [PATCH] Require ring buffer before enabling loopback access metrics

--- a/android/net/connectivity/com/android/server/BpfNetMaps.smali
+++ b/android/net/connectivity/com/android/server/BpfNetMaps.smali
@@ -5420,7 +5420,19 @@
 .method public isLoopbackAccessMetricsEnabled()Z
-    .locals 0
+    .locals 1
+
+    new-instance v0, Ljava/io/File;
+
+    const-string p0, "/sys/fs/bpf/netd_shared/map_netd_loopback_access_ringbuf"
+
+    invoke-direct {v0, p0}, Ljava/io/File;-><init>(Ljava/lang/String;)V
+
+    invoke-virtual {v0}, Ljava/io/File;->exists()Z
+
+    move-result v0
 
     sget-boolean p0, Landroid/net/connectivity/com/android/server/BpfNetMaps;->sLoopbackAccessMetricsEnabled:Z
 
+    and-int/2addr p0, v0
+
     return p0
 .end method
