    <string name="onerom_guide_title">OneROM Documentation &amp; Guide</string>
    <string name="onerom_guide_summary">System architecture overview, gesture shortcuts, and platform configurations.</string>
    <string name="onerom_guide_navigation_title">System Navigation &amp; Shortcuts</string>
    <string name="onerom_guide_navigation_summary">Device information shortcuts: Single-tap About Phone for hardware specification, double-tap for Software Details, or touch-and-hold to launch Developer Options.</string>
    <string name="onerom_guide_settings_title">System Customization</string>
    <string name="onerom_guide_settings_summary">Configure custom interface banners, hardware key remapping (Bixby button), and system preferences via OneROM Settings.</string>
    <string name="onerom_guide_platform_title">Platform Architecture &amp; Security</string>
    <string name="onerom_guide_aod_title">Always On Display Calibration</string>
    <string name="onerom_guide_aod_summary">Optimized low-power display state and ambient clock rendering calibrated for the Galaxy S10 Dynamic AMOLED display panel.</string>
    <string name="onerom_guide_root_title">KernelSU Next Subsystem</string>
    <string name="onerom_guide_root_summary">Integrated kernel-level root access via OneKernel. The KernelSU Next manager is directly accessible from the Software Information page.</string>
    <string name="onerom_guide_privacy_title">Hardware Identifier Privacy</string>
    <string name="onerom_guide_privacy_summary">Protect device identifiers with hardware spoofing controls. Mask the IMEI, serial number, and developer status across system preferences.</string>
    <string name="onerom_credits_title">Credits &amp; Acknowledgements</string>
    <string name="onerom_credits_unica_summary">Developed by MesaLabs (@salvogiangri) and contributors. Foundational ROM porting framework, smali modification engine, and One UI patches.</string>
    <string name="onerom_credits_artisan_summary">Developed by the Artisan OS team. Over-the-air (OTA) update client, synchronization protocols, and system services.</string>
    <string name="onerom_credits_extremerom_summary">Developed by ExtremeXT and contributors. Exynos 9820 hardware bringup, OneKernel source tree, KernelSU Next integration, and hardware adaptation for Galaxy S10.</string>
    <string name="onerom_credits_onerom_summary">Maintained by @DaManMikey. One UI 8.5 (Android 16) port, native OneROM Settings, privacy features, Bixby remapping, OTA backend, and UI refinements.</string>
    <string name="onerom_credits_blackmesa_summary">Developed by BlackMesa123. One UI Settings Hook module architecture enabling custom Samsung Settings integration.</string>
