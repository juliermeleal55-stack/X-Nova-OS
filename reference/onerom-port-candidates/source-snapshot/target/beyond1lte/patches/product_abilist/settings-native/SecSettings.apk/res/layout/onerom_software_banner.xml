<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/onerom_banner_background"
    android:clipToOutline="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@id/onerom_banner_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/onerom_s10_wallpaper" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />
    <TextView
        android:id="@id/onerom_banner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="8dp"
        android:text="@string/onerom_banner_default"
        android:textColor="#ffffffff"
        android:textSize="20sp"
        android:fontFamily="sec"
        android:textFontWeight="600"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4" />
</FrameLayout>