Subject: [PATCH] Enable S10 multi-resolution on Android 17

diff --git a/smali_classes6/com/samsung/android/rune/CoreRune.smali b/smali_classes6/com/samsung/android/rune/CoreRune.smali
--- a/smali_classes6/com/samsung/android/rune/CoreRune.smali
+++ b/smali_classes6/com/samsung/android/rune/CoreRune.smali
@@ -2992,8 +2992,10 @@
     sput-boolean v0, Lcom/samsung/android/rune/CoreRune;->FW_TSP_DEADZONE_LARGE_FLIP_COVER:Z
 
-    sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_SUPPORT_MULTI_RESOLUTION:Z
+    const/4 v2, 0x1
 
-    sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_DYNAMIC_RESOLUTION_CONTROL:Z
+    sput-boolean v2, Lcom/samsung/android/rune/CoreRune;->FW_SUPPORT_MULTI_RESOLUTION:Z
+
+    sput-boolean v2, Lcom/samsung/android/rune/CoreRune;->FW_DYNAMIC_RESOLUTION_CONTROL:Z
 
     sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_RESOLUTION_VOTE_POLICY:Z
 
@@ -3000,7 +3002,7 @@
     sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_RESOLUTION_POLICY_FOR_SHELL_TRANSITION:Z
 
-    sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_MULTI_RESOLUTION_POLICY:Z
+    sput-boolean v2, Lcom/samsung/android/rune/CoreRune;->FW_MULTI_RESOLUTION_POLICY:Z
 
     sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_DENSITY_MAPPING:Z
 
     sput-boolean v4, Lcom/samsung/android/rune/CoreRune;->FW_RESOLUTION_VOTE_FOR_BLOCK_APP:Z
-- 
2.49.1