Subject: [PATCH] Reserve S10 right-corner cutout space in SystemUI

diff --git a/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenAlgorithmNoCutout.smali b/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenAlgorithmNoCutout.smali
--- a/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenAlgorithmNoCutout.smali
+++ b/smali_classes3/com/android/systemui/statusbar/phone/IndicatorGardenAlgorithmNoCutout.smali
@@ -95,9 +95,48 @@
 .method public final calculateRightPadding()I
-    .locals 0
+    .locals 4
 
     invoke-virtual {p0}, Lcom/android/systemui/statusbar/phone/IndicatorGardenAlgorithm;->getDefaultSidePadding()I
 
-    move-result p0
+    move-result v0
 
-    return p0
+    iget-object v1, p0, Lcom/android/systemui/statusbar/phone/IndicatorGardenAlgorithm;->inputProperties:Lcom/android/systemui/statusbar/phone/IndicatorGardenInputProperties;
+
+    iget v3, v1, Lcom/android/systemui/statusbar/phone/IndicatorGardenInputProperties;->rotation:I
