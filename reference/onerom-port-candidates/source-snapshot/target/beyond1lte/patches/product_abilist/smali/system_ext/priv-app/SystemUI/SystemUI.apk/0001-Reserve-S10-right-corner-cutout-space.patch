+    move-result-object v2
+
+    invoke-virtual {v2}, Landroid/graphics/Rect;->isEmpty()Z
+
+    move-result v3
+
+    if-nez v3, :s10_right_padding_done
+
+    iget v3, v2, Landroid/graphics/Rect;->right:I
+
+    iget p0, v1, Lcom/android/systemui/statusbar/phone/IndicatorGardenInputProperties;->statusBarWidth:I
+
+    if-ne v3, p0, :s10_right_padding_done
+
+    iget v2, v2, Landroid/graphics/Rect;->left:I
+
+    sub-int/2addr p0, v2
+
+    iget v1, v1, Lcom/android/systemui/statusbar/phone/IndicatorGardenInputProperties;->cutoutSidePaddingD:I
+
+    add-int/2addr p0, v1
+
+    invoke-static {v0, p0}, Ljava/lang/Math;->max(II)I
+
+    move-result v0
+
+    :s10_right_padding_done
+    return v0
 .end method
