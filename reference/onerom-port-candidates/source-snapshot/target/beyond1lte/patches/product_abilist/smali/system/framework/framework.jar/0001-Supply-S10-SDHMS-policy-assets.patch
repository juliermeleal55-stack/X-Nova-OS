Subject: [PATCH] Supply S10 policy assets to signed SDHMS

diff --git a/smali/android/content/res/AssetManager.smali b/smali/android/content/res/AssetManager.smali
--- a/smali/android/content/res/AssetManager.smali
+++ b/smali/android/content/res/AssetManager.smali
@@ -3193,6 +3193,75 @@
     :try_start_0
     invoke-direct {p0}, Landroid/content/res/AssetManager;->ensureOpenLocked()V
 
+    const-string v1, "siop_default"
+
+    invoke-virtual {v1, p1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v2
+
+    if-nez v2, :s10_policy_package
+
+    const-string v1, "siop_model"
+
+    invoke-virtual {v1, p1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v2
+
+    if-nez v2, :s10_policy_package
+
+    const-string v1, "ssrm_default"
+
+    invoke-virtual {v1, p1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v2
+
+    if-eqz v2, :s10_policy_fallback
+
+    :s10_policy_package
+    invoke-static {}, Landroid/app/ActivityThread;->currentPackageName()Ljava/lang/String;
+
+    move-result-object v1
+
+    const-string v2, "com.sec.android.sdhms"
+
+    invoke-virtual {v2, v1}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v1
+
+    if-eqz v1, :s10_policy_fallback
+
+    new-instance v1, Ljava/lang/StringBuilder;
+
+    const-string v2, "/system/etc/s10-sdhms/"
+
+    invoke-direct {v1, v2}, Ljava/lang/StringBuilder;-><init>(Ljava/lang/String;)V
+
+    invoke-virtual {v1, p1}, Ljava/lang/StringBuilder;->append(Ljava/lang/String;)Ljava/lang/StringBuilder;
+
+    invoke-virtual {v1}, Ljava/lang/StringBuilder;->toString()Ljava/lang/String;
+
+    move-result-object v1
+
+    new-instance v2, Ljava/io/File;
+
+    invoke-direct {v2, v1}, Ljava/io/File;-><init>(Ljava/lang/String;)V
+
+    invoke-virtual {v2}, Ljava/io/File;->isFile()Z
+
+    move-result v3
+
+    if-eqz v3, :s10_policy_fallback
+
+    new-instance v1, Ljava/io/FileInputStream;
+
+    invoke-direct {v1, v2}, Ljava/io/FileInputStream;-><init>(Ljava/io/File;)V
+
+    monitor-exit p0
+
+    return-object v1
+
+    :s10_policy_fallback
+
     iget-wide v1, p0, Landroid/content/res/AssetManager;->mObject:J
 
     invoke-static {v1, v2, p1, p2}, Landroid/content/res/AssetManager;->nativeOpenAsset(JLjava/lang/String;I)J
-- 
